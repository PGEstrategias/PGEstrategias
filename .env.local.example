# ── Envío de correos (Google Workspace / Gmail SMTP) ─────────────
# Copia este archivo como .env.local y llena los valores reales.
# NO subas .env.local al repo (ya está en .gitignore).

# Tu correo de Google Workspace
GMAIL_USER=contacto@pgestrategias.com

# App Password de 16 caracteres (NO tu contraseña normal).
# Generar en: https://myaccount.google.com/apppasswords
# Requiere verificación en 2 pasos activada en la cuenta.
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── Panel de envío /enviar (usuario y contraseña para entrar) ─────
# Protege la página /enviar y el endpoint real /api/enviar.
PANEL_USER=pge
PANEL_PASSWORD=inventa-una-contrasena-fuerte

# ── Endpoint de prueba rápida /api/enviar-prueba (opcional) ───────
# Clave secreta para el endpoint de prueba por URL. Si no la usas,
# puedes borrar la ruta app/api/enviar-prueba.
EMAIL_API_TOKEN=inventa-un-token-secreto

# ── Demo de invitaciones digitales (/invitacionesdebodas/demo) ────
# Webhook de n8n que guarda cada confirmación del demo en Google Sheets.
# Opcional: si se deja vacío, el demo funciona igual y solo no se registra.
N8N_RSVP_WEBHOOK_URL=

# ── Lista Médica (/listamedicamx) ─────────────────────────────────
# Domicilio fiscal del responsable. Aparece en el Aviso de Privacidad
# y en los Términos. Sin él, el aviso se publica marcado como incompleto.
LISTAMEDICA_DOMICILIO_FISCAL=Calle y número, Colonia, C.P.

# Origen absoluto del sitio, para canonical, JSON-LD y sitemap.
NEXT_PUBLIC_SITE_URL=https://pgestrategias.com

# Subpath del directorio. Al migrar a listamedica.mx se deja vacío.
NEXT_PUBLIC_LISTAMEDICA_BASE_PATH=/listamedicamx

# Carpeta con permiso de escritura para los JSON y las evidencias de
# verificación. En local no hace falta: usa data/listamedica del repo.
# LISTAMEDICA_DATA_DIR=/var/data/listamedica

# Píxel de Meta y API de Conversiones (evento clic_whatsapp). Opcionales.
# NEXT_PUBLIC_META_PIXEL_ID=
# META_CAPI_TOKEN=

# Calificación de Google en los perfiles, y geocodificación en el panel.
# Sin llave, el panel usa Nominatim de OpenStreetMap.
# GOOGLE_PLACES_API_KEY=
# GOOGLE_MAPS_API_KEY=
