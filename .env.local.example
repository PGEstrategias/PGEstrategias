# ── Envío de correos (Google Workspace / Gmail SMTP) ─────────────
# Copia este archivo como .env.local y llena los valores reales.
# NO subas .env.local al repo (ya está en .gitignore).

# Tu correo de Google Workspace
GMAIL_USER=contacto@pgestrategias.com

# App Password de 16 caracteres (NO tu contraseña normal).
# Generar en: https://myaccount.google.com/apppasswords
# Requiere verificación en 2 pasos activada en la cuenta.
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
